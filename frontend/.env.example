# ---- SalamaLine configuration. Copy to your host's environment settings. ----
# Never commit real values. Generate each secret with:  openssl rand -base64 48

# LIVE MODE. Leave unset for demo (placeholder content allowed, nothing real is sent).
# Set to 1 only when content is approved, services verified, responders trained.
# In live mode the app REFUSES to serve unapproved content or start without the keys below.
SALAMA_LIVE=

# Privacy keys (required in live mode, 32+ chars). LOSING THE ENCRYPTION KEY makes open
# cases unreadable; changing the HMAC key breaks "delete my data" for existing cases. Back both up.
SALAMA_HMAC_KEY=
SALAMA_ENC_KEY=

# Database (Neon / Postgres). Migrations in /migrations run on deploy.
DATABASE_URL=

# SMS gateway: Africa's Talking (AT_USERNAME=sandbox for their sandbox)
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# WhatsApp Cloud API (optional)
WA_TOKEN=
WA_PHONE_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_API_VERSION=     # optional, e.g. v22.0 (default). Update when Meta retires a version.

# Webhook + operations secrets
WEBHOOK_SECRET=     # append ?key=... to the USSD and SMS callback URLs
CRON_SECRET=        # protects /api/cron/sweep (must run every ~5 minutes)
DASHBOARD_TOKEN=    # partners paste this at /dashboard
ADMIN_TOKEN=        # manages the responder roster

# Optional
SALAMA_HELPLINE=116        # free helpline shown to every user (verify the number before launch)
SALAMA_SMS_PREFIX=Salama   # neutral sender label on SMS to girls
