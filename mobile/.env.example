# Base URL of the existing SalamaLine NestJS API, including the global prefix.
# Local Android emulator: http://10.0.2.2:3000/api/v1
# Local iOS simulator:   http://localhost:3000/api/v1
# Physical device:       http://<your-computer-lan-ip>:3000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# The same base URL is used by auth, content, services, help requests, case
# tracking and the AI endpoints (GET /ai/health and POST /ai/ask). AI provider
# keys stay server-side in backend/.env; never put them in this file.
# No secrets belong in this file. Tokens are stored with expo-secure-store.
