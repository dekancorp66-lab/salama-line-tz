NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Include each deployed frontend origin here; separate origins with commas.
# Required in production; localhost defaults apply only in development.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080
DATABASE_URL=postgresql://salamaline:salamaline_dev_password@localhost:5432/salamaline?schema=public
# Required for every environment. There is no fallback secret.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
BCRYPT_ROUNDS=12
# Per-account login abuse controls.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
# Open cases older than this are auto-expired and their contact details wiped.
CASE_RETENTION_HOURS=168
# Swagger is disabled unless this is explicitly set to true.
SWAGGER_ENABLED=false
# Express "trust proxy" for correct client-IP rate limiting behind a proxy.
# false (default) never trusts X-Forwarded-For; use a hop count (e.g. 1) or a
# comma-separated list of trusted proxy IPs/CIDRs. "true" trusts all proxies.
TRUST_PROXY=false
# Optional: set only after a real provider is selected and configured.
SMS_PROVIDER=disabled
SMS_API_URL=
SMS_API_KEY=
WHATSAPP_PROVIDER=disabled
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
# Do not place real phone numbers or secrets in logs.

# --- One-time initial Super Administrator bootstrap ---------------------------
# Promote the already-registered owner account to SUPER_ADMIN in place. This
# preserves the account id and password hash; no password is read or logged.
# Run: npm run bootstrap:super-admin
# SEED_ADMIN_EMAIL must equal the owner address in the bootstrap allowlist.
# SEED_ADMIN_USER_ID is an optional safety pin; when set it must match that
# account's id. Public registration can never grant SUPER_ADMIN.
# SEED_ADMIN_EMAIL=wilbardmagaso777@gmail.com
# SEED_ADMIN_USER_ID=cmwl0qwa50000y9m0kyd7niry

# Required in production; at least 32 characters and separate from JWT_ACCESS_SECRET.
CONTACT_HASH_SECRET=replace-with-a-separate-random-secret-at-least-32-characters

# Server-only OpenAI API. Configure the key in backend/.env, never in the frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_ENABLED=false
# Production remains on the local grounded answer path until the organization
# confirms the under-18 safeguards and eligibility.
OPENAI_MINOR_SAFEGUARDS_CONFIRMED=false
